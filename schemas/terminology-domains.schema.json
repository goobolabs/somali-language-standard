{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminology-domains.schema.json",
  "title": "SLS Terminology Domains",
  "description": "Controlled vocabulary linking terminology domain codes, file slugs, display names, and standards.",
  "schema_version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "slug",
          "name",
          "standard_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "standard_id": {
            "type": "string",
            "pattern": "^SLS-02[0-9]{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
